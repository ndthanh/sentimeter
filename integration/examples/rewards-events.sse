tle":"Transaction meets programme conditions","status":"Eligible","body":"International online rate: 8%. Transaction amount exceeds VND 200,000.","at":115,"evidence":{"screen":"KNOWLEDGE LIBRARY / VISA EVERYDAY","reference":"EVERYDAY-DEMO-OCT-2026","fields":[["Document","Visa Everyday rewards terms"],["Version","DEMO-OCT-2026"],["Effective period","01–31 Oct 2026"],["Product scope","Visa Everyday"],["Applicable rule","International online spending"]],"columns":["Rule","Programme condition","This transaction","Result"],"rows":[["Channel","Online","E-commerce","Pass"],["Minimum spend","Above VND 200,000","VND 12,000,000","Pass"],["Domestic online rate","5%","Not applicable","—"],["International online rate","8%","International","Applicable"],["Monthly ceiling","500,000 points","Check Rewards Portal","Pending cap check"]],"conclusion":"Programme conditions are met. MCC exclusions and monthly points must also be checked.","note":"Demo terms supplied for this scenario. Point conversion and rounding are not specified; no exact credit amount is calculated."}},{"id":"mcc","source":"MCC Reference","icon":"XLS","task":"Check merchant category against the exclusion list","title":"MCC 4722 is not excluded","status":"Passed","body":"Travel agencies and tour operators. No match in the exclusion list.","at":140,"evidence":{"screen":"MCC EXCLUSIONS.xlsx / LOOKUP","reference":"MCC-DEMO-2026-10","fields":[["Workbook","Everyday_MCC_Exclusions_DEMO.xlsx"],["Worksheet","MCC lookup"],["Search value","4722"],["Category","Travel agencies and tour operators"],["Excluded","No"]],"columns":["MCC","Merchant category","Excluded","Lookup result"],"rows":[["4722","Travel agencies and tour operators","No","Matched transaction"],["6011","Automated cash disbursements","Yes","Illustrative reference"],["6051","Quasi-cash transactions","Yes","Illustrative reference"]],"conclusion":"MCC 4722 does not prevent this transaction from earning points.","note":"Workbook rows are fabricated for the demo, not an official bank exclusion list."}},{"id":"ido","source":"IDO","icon":"ID","task":"Find loyalty membership using Customer ID","title":"Loyalty membership matched","status":"Linked","body":"Customer 10002048 is linked to loyalty member 80620481. Membership is active.","at":160,"evidence":{"screen":"MEMBER PROFILE / CUSTOMER SEARCH","reference":"IDO-80620481","fields":[["Customer ID","10002048"],["Customer name","Nguyen Minh Ha"],["Loyalty ID","80620481"],["Registered phone","090 123 4682"],["Membership status","Active"],["Enrolment date","20 Feb 2024"]],"columns":["Customer ID","Loyalty ID","Programme","Status"],"rows":[["10002048","80620481","Rewards","Active"]],"conclusion":"Use loyalty ID 80620481 to retrieve transaction history in the Rewards Portal."}},{"id":"portal","source":"Rewards Portal","icon":"RP","task":"Check transaction outcome and monthly points total","title":"Transaction failed — no points credited","status":"Cause identified","warn":true,"body":"The queried transaction is FAILED in the portal. Successful monthly credits total 180,000 / 500,000 points; the cap is not reached.","at":218,"evidence":{"screen":"REWARDS / MEMBER TRANSACTION HISTORY","reference":"RP-20261015-884291","fields":[["Loyalty ID","80620481"],["Query period","01–31 Oct 2026"],["Transaction reference","TX-20261015-884291"],["Merchant","TRIP.COM"],["Spend amount","VND 12,000,000"],["Transaction status","FAILED"],["Points credited","0"],["Successful monthly credits","180,000 points"],["Monthly cap","500,000 points"],["Remaining allowance","320,000 points"]],"columns":["Date","Reference","Merchant","Status","Points credited"],"rows":[["03 Oct","RW-1003-001","ONLINE STORE A","SUCCESS","60,000"],["08 Oct","RW-1008-002","ONLINE STORE B","SUCCESS","80,000"],["12 Oct","RW-1012-003","ONLINE STORE C","SUCCESS","40,000"],["15 Oct","TX-20261015-884291","TRIP.COM","FAILED","0"]],"ledger":[{"status":"SUCCESS","points":60000},{"status":"SUCCESS","points":80000},{"status":"SUCCESS","points":40000},{"status":"FAILED","points":0}],"sumSuccess":180000,"cap":500000,"remaining":320000,"transactionStatus":"FAILED","conclusion":"The transaction failed in the Rewards Portal, so no points were credited. The monthly points cap is not the cause.","note":"Monthly total includes SUCCESS records only. All records shown are fabricated for this scenario."}}],"agents":[{"id":"t24","name":"T24","status":"completed","task":"Identify card product and linked account"},{"id":"fimi","name":"FIMI","status":"completed","task":"Locate transaction, channel and merchant details"},{"id":"policy","name":"Programme Terms","status":"completed","task":"Check applicable earning rules"},{"id":"mcc","name":"MCC Reference","status":"completed","task":"Check merchant category against the exclusion list"},{"id":"ido","name":"IDO","status":"completed","task":"Find loyalty membership using Customer ID"},{"id":"portal","name":"Rewards Portal","status":"completed","task":"Check transaction outcome and monthly points total"}],"recommendation":{"title":"No points credited because the transaction failed","answer":"Your VND 12,000,000 Trip.com transaction on 15 October is marked as failed in the Rewards Portal, which is why no points were credited. We have checked your card's programme terms, the merchant category and your monthly points limit. The programme conditions are met and your monthly cap has not been reached. I can register a follow-up request to review the failed transaction.","solution":"Register a follow-up to review the failed transaction."},"signals":{"emotion":"Listening","confidence":"Insufficient evidence","guidance":"Confirm identity and listen to the customer."}}}

